# Server configuration
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Public canonical URL in production (used for checkout return URLs & receipt emails)
# PUBLIC_URL=https://framevault.dev

# HMAC-SHA256 secret for signing license access cookies (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ORIGINKIT_SECRET=

# SQLite database file path (defaults to ./data/originkit.sqlite)
DATABASE_PATH=./data/originkit.sqlite

# Optional Turso Cloud SQLite (FREE tier at https://turso.tech)
# Keeps paid licenses persistent forever on free ephemeral hosts like Render Free Tier!
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Pricing (in smallest currency unit: paise for INR, cents for USD)
# Example for Razorpay INR (₹399): LICENSE_CURRENCY=INR, LICENSE_PRICE_CENTS=39900, LICENSE_PRICE_DISPLAY=₹399
# Example for USD ($4.99):         LICENSE_CURRENCY=USD, LICENSE_PRICE_CENTS=499,   LICENSE_PRICE_DISPLAY=$4.99
LICENSE_CURRENCY=INR
LICENSE_PRICE_CENTS=39900
LICENSE_PRICE_DISPLAY=₹399

# Razorpay test/live credentials (get from https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# Setting RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET automatically enables Razorpay Checkout and disables demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set webhook URL in Razorpay Dashboard to: https://<your-domain>/api/webhooks/razorpay
# Subscribe to events: payment.captured, order.paid, refund.processed, payment.dispute.created
RAZORPAY_WEBHOOK_SECRET=

# Optional Stripe live/test credentials (used if Razorpay is not configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Resend API key for emailing license key receipts & recovery emails
RESEND_API_KEY=
EMAIL_FROM=FrameVault <receipts@framevault.dev>

# Security / Proxy settings
TRUST_PROXY=true
COOKIE_SECURE=false
# Explicitly control local demo checkout in non-production (automatically false in production or when Razorpay/Stripe is set)
ALLOW_DEMO_CHECKOUT=true
